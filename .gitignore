# --- Build artifacts ---
foundation
solver
tools/ref/refsolve
*.o
*.obj
*.a

# --- Instructor-only material (NEVER commit to the student repo) ---
# The generator itself (tools/gen) IS shipped -- students need it to make
# practice instances with their own seeds. Only the secret seed, the instances
# it produces, and the design rationale stay behind.
docs/
tools/manifest/hidden.json
checksums/hidden.sha256
instances_hidden/
outputs/

# --- Per-student / local work ---
baseline_times.txt
solver_times.txt
machine.txt
diff_from_foundation.patch
*.tmp.out
grade_result.json

# --- Downloadable tiers (distributed via GitHub Releases, not git) ---
# Only the *_dev tier is committed.
instances/*_medium.graph
instances/*_medium.queries
instances/*_medium.answers
instances/*_medium.meta.json
instances/*_large.graph
instances/*_large.queries
instances/*_large.answers
instances/*_large.meta.json
instances/*.qplan
instances/*.gz

# --- Tooling ---
.claude/
.vscode/
.idea/
__pycache__/
*.pyc

# --- OS junk ---
.DS_Store
Thumbs.db
